# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/

# Packaging
build/
dist/
*.egg-info/

# Agent scratch space
.thoughtmachine/

# LaTeX build artefacts (keep the sources, drop the junk)
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.xdv
.tools/
.build.exit
reports/

# Scratch runs (ad-hoc harnesses, never committed)
.scratch/
.tm_*.py
temp/

# KiCad machine-local state (the project file is the source of truth)
*.kicad_prl
*.kicad_sch.lck
fp-info-cache
*-backups/
_autosave-*

# Study outputs (generated by emfit/studies.py and the CLI)
study-out/

.tools/texcache/
.scratch/report-build/

# Host-script outputs (cached spectra, logs, figures)
tools/host/*/out/

# Explicit artefact paths (anchored at the repository root)
/out/
/tmp_job2/
/tools/host/c1-audit/out_pec_v2/
/tools/host/c1-audit/out_v2/
/tools/host/sparse-probe/out_rung4/
/tools/host/sparse-probe/out_sparse_run1.txt

# Wave visualiser player state (written at the repo root; regenerable)
/state.json

# numpy field dumps (binary, regenerated by render_fields.py consumers)
*.npz
# frozen test fixtures under tests/data/ are exempt from the *.npz dump rule
!tests/data/*.npz
